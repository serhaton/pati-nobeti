{
  "expo": {
    "name": "Pati Nöbeti",
    "slug": "pati-nobeti",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "patinobeti",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#E3EFE6"
