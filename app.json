{
  "expo": {
    "name": "Pati Uzat",
    "slug": "pati-uzat",
    "version": "1.0.0",
    "icon": "./assets/app-icon.png",
    "orientation": "portrait",
    "scheme": "patiuzat",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/app-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#E3EFE6"
    },
    "ios": {
      "icon": "./assets/app-icon.png",
      "supportsTablet": true,
      "buildNumber": "4",
      "bundleIdentifier": "com.serhatonal.patiuzat",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Pati Uzat uses your location only while you use the app, for example to center the map near you and help you add a nearby feeding point.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Pati Uzat uses your location only while you use the app, for example to center the map near you and help you add a nearby feeding point.",
        "NSLocationAlwaysUsageDescription": "Pati Uzat uses your location only while you use the app, for example to center the map near you and help you add a nearby feeding point."
      }
    },
    "plugins": [
      "expo-router",
      "expo-image-picker",
      "expo-location",
      "expo-notifications",
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "androidAppId": "ca-app-pub-3940256099942544~3347511713"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "52234822-382b-4325-bd92-7b2b759231be"
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.serhatonal.patiuzat"
    },
    "owner": "serhaton"
  }
}
