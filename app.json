    "plugins": [
      "expo-router",
      "expo-image-picker",
      "expo-location"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f3b1269a-ab50-4c23-9822-ae0642d8a5b8"
      }
    }
  }
}
